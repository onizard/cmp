# Copie ce fichier en .env (ou lance `node gen-keys.mjs` qui le crée pour toi),
# puis renseigne les 3 valeurs marquées « À REMPLIR ».

# --- Postgres (généré automatiquement) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-moi

# --- JWT partagé par Auth / REST / Realtime (généré automatiquement) ---
JWT_SECRET=change-moi
JWT_EXPIRY=3600
ANON_KEY=change-moi
SERVICE_ROLE_KEY=change-moi

# --- Realtime (généré automatiquement) ---
SECRET_KEY_BASE=change-moi
# Exactement 16 caractères (chiffrement AES-128 de Realtime).
REALTIME_DB_ENC_KEY=change-moi-16car

# --- Adresse publique servie par le tunnel Cloudflare ---
# À REMPLIR : le sous-domaine que tu choisis, ex. https://cmp.break-pharma.fr
PUBLIC_URL=https://cmp.exemple.fr

# --- E-mail du lien magique (via Resend) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=À_REMPLIR_cle_api_resend
SMTP_ADMIN_EMAIL=noreply@ton-domaine.fr
SMTP_SENDER_NAME=CMP

# --- Jeton du tunnel Cloudflare ---
# À REMPLIR : jeton fourni par Cloudflare Zero Trust (voir README)
CF_TUNNEL_TOKEN=À_REMPLIR_jeton_cloudflare
